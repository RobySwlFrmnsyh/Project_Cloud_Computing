# Server
PORT=4000
NODE_ENV=development

# Database
# Untuk pengembangan lokal tanpa Docker, biarkan USE_EMBEDDED_DB=true.
# Pada Tahap 3 (Docker), set false dan arahkan DATABASE_URL ke service postgres.
USE_EMBEDDED_DB=true
DATABASE_URL=postgres://ajt:ajt@127.0.0.1:5433/ajt
PG_DATA_DIR=.pgdata

# Keamanan
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
COOKIE_NAME=ajt_session
COOKIE_SECURE=false

# Frontend yang boleh memanggil API secara langsung
CORS_ORIGIN=http://localhost:5173

# Seed data demo saat database masih kosong
SEED_DEMO=true
# Izinkan endpoint reset data demo (khusus admin)
ALLOW_DEMO_RESET=true

# Routing jalan untuk jarak/tarif dan garis rute (OSRM publik)
ROAD_ROUTING_ENABLED=true
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=6000
