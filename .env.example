# Interface host yang mempublikasikan port container.
# Gunakan 127.0.0.1 bila akses hanya dari mesin yang sama.
HOST_BIND=0.0.0.0

# Port yang dipublikasikan ke host VM
FRONTEND_PORT=8080
BACKEND_PORT=4000
ADMINER_PORT=8081

# Database PostgreSQL (dipakai service db dan backend)
POSTGRES_USER=ajt
POSTGRES_PASSWORD=ganti-dengan-password-acak
POSTGRES_DB=ajt

# Keamanan backend
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
COOKIE_NAME=ajt_session
# false untuk akses HTTP (localhost). Set true bila memakai HTTPS.
COOKIE_SECURE=false

# Batas request API (millisecond dan jumlah per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100

# Origin browser yang diizinkan. Tambahkan alamat lain bila perlu.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://10.0.2.15:8080

# Seed data demo saat database masih kosong
SEED_DEMO=true
# Izinkan reset data demo oleh admin
ALLOW_DEMO_RESET=true

# Routing jalan untuk jarak/tarif dan garis rute (OSRM publik)
ROAD_ROUTING_ENABLED=true
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=6000

# Opsional: Mapbox Geocoding (dipakai lebih dulu bila token valid).
# Token perlu scope geocoding; gunakan token tanpa batasan URL untuk akses server-side.
# MAPBOX_ACCESS_TOKEN=pk.ganti-dengan-token-mapbox
# Opsional: Google Places API (New) + Geocoding API.
# Biarkan kosong untuk memakai Photon + Nominatim.
# GOOGLE_MAPS_API_KEY=ganti-dengan-api-key-google
GEOCODE_TIMEOUT_MS=8000
